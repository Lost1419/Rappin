            {
              "path": "docs/openapi.json",
              "sha256": "73a51811d7ef5b392c8168b5868813fee2d4be00c360d02dcd86f1d9edf128c8"
            }
          ]
        },
        "worker": {
          "status": "partial",
          "reason": "WorkerContext::api can send raw JSON through the parent. Typed message helpers and validated bindings do not implement sticker semantics. Workers require hot-reload.",
          "evidence": [
            {
              "path": "src/hot_reload/worker.rs",
              "sha256": "877e47d6ffd6e107e0b8292eeda284aafe997c6307ad61c82fe5a9ff8f0d2c0c"
            },
            {
              "path": "src/models/message.rs",
              "sha256": "2b3201fb63221b708a2a8c20c65467811a862878e89eef869cb7fd3dd5d00759"
            }
          ]
        },
        "cli_mcp": {
