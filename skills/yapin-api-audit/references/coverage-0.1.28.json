        {
          "method": "POST",
          "path": "/channels/{id}/messages"
        }
      ],
      "api_sources": [
        "https://www.yapin.gg/openapi.json",
        "https://www.yapin.gg/developers"
      ],
      "surfaces": {
        "typed": {
          "status": "missing",
          "reason": "CreateMessage and UiMessageBody have no sticker_id field or typed sticker constructor.",
          "evidence": [
            {
              "path": "src/models/message.rs",
              "sha256": "2b3201fb63221b708a2a8c20c65467811a862878e89eef869cb7fd3dd5d00759"
            },
            {
              "path": "src/models/ui.rs",
              "sha256": "24145b251b9c1e6d8600138d5fd55ee58ba479d5d6d76922c7b1187bd64ab663"
            }
          ]
        },
        "low_level": {
          "status": "supported",
          "reason": "Client::request/Api::request can submit raw sticker_id JSON; callers supply exclusivity, UUID, scope and rollout checks. This is request transport support only.",
          "evidence": [
            {
              "path": "src/client.rs",
              "sha256": "34e48e08d113613696126afd1fda8ff327f80a29b7cef1e8dbce23b40871ef26"
            },
            {
              "path": "src/api.rs",
              "sha256": "4f49c8d0f77700744b57c747ef1131b7d984c7ff1dc2b773f8e25483891301dd"
            }
          ]
        },
        "validated_bindings": {
          "status": "missing",
          "reason": "send_message parses a typed UiMessageBody and validates against the bundled schema, which lacks sticker_id; there is no safe sticker binding.",
          "evidence": [
            {
              "path": "src/capabilities/validation.rs",
              "sha256": "172a1684c0cfaf9953f8f7557d7f72dd1209f332e31ced4c755755092f0c12e7"
            },
            {
              "path": "src/capabilities/schema.rs",
